{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["netlify/functions/**/*.mts", "netlify/functions/**/*.ts", "scripts/lib/**/*.mjs"],
  "exclude": ["netlify/functions/**/*.test.ts"]
}
